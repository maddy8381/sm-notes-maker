# Copy to .env.local for development. Never commit the filled-in version.

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# Pooled connection string, used by the app at runtime.
# Neon dashboard -> your project -> Connection Details -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection. Prisma Migrate needs this: schema changes and
# advisory locks do not work through a connection pooler.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin. Used to build password-reset links and to validate the Origin
# header on state-changing requests, so it must match how the app is reached.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ random bytes. Generate with:  openssl rand -base64 48
# Signs and validates non-session tokens. Rotating it invalidates outstanding
# password-reset links.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Image storage — Vercel Blob
# ---------------------------------------------------------------------------
# Vercel dashboard -> Storage -> your Blob store -> tokens.
# Left empty, image upload is disabled and the editor says so; everything else
# works, which keeps local setup possible without a Blob store.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Cron (production only)
# ---------------------------------------------------------------------------
# Shared secret Vercel Cron sends as `Authorization: Bearer ...`. Without it the
# maintenance endpoints refuse to run.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Separate Neon branch. Integration tests TRUNCATE between runs, so this must
# never point at a database with real data.
TEST_DATABASE_URL=""
